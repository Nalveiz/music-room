{
  "expo": {
    "name": "expo-enterprise-boilerplate",
    "slug": "expo-enterprise-boilerplate",
    "version": "1.0.0",
    "githubUrl": "https://github.com/HsynDmrl/Expo-enterprise-boilerplate",
    "orientation": "portrait",
    "backgroundColor": "#f7f8fa",
    "icon": "./assets/images/icon.png",
    "scheme": "musicroom",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
